<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="rc2C3n3kaGY8YtA5Bkzh">
    <mxGraphModel dx="6195" dy="8056" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="4681" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml class_diagram\ntitle Orders Management System - Class Diagram\n\nskinparam classAttributeIconSize 0\nskinparam classFontSize 13\nskinparam packageStyle rectangle\n\n&#39; ─── Model ───────────────────────────────────────────────\npackage \&quot;org.mishu.Model\&quot; {\n  class Client {\n    - id : int\n    - name : String\n    - address : String\n    - email : String\n    + Client()\n    + Client(id, name, email, address)\n    + Client(name, email, address)\n    + getId() : int\n    + setId(id : int)\n    + getName() : String\n    + setName(name : String)\n    + getAddress() : String\n    + setAddress(address : String)\n    + getEmail() : String\n    + setEmail(email : String)\n  }\n\n  class Product {\n    - id : int\n    - name : String\n    - price : double\n    - quantity : int\n    + Product()\n    + Product(id, name, price, quantity)\n    + Product(name, price, quantity)\n    + getId() : int\n    + getName() : String\n    + getPrice() : double\n    + getQuantity() : int\n    + setId(id : int)\n    + setName(name : String)\n    + setPrice(price : double)\n    + setQuantity(quantity : int)\n  }\n\n  class Orders {\n    - id : int\n    - clientId : int\n    - productId : int\n    - quantity : int\n    + Orders()\n    + Orders(id, clientId, productId, quantity)\n    + Orders(clientId, productId, quantity)\n    + getId() : int\n    + getClientId() : int\n    + getProductId() : int\n    + getQuantity() : int\n    + setId(id : int)\n    + setClientId(clientId : int)\n    + setProductId(productId : int)\n    + setQuantity(quantity : int)\n  }\n\n  class Bill &lt;&lt;record&gt;&gt; {\n    + id : int\n    + orderId : int\n    + clientId : int\n    + productId : int\n    + quantity : int\n    + total : double\n  }\n}\n\n&#39; ─── Utils ───────────────────────────────────────────────\npackage \&quot;org.mishu.Utils\&quot; {\n  class QuerySettings &lt;&lt;record&gt;&gt; {\n    + all : boolean\n    + useLike : boolean\n  }\n\n  package \&quot;org.mishu.Utils.Exceptions\&quot; {\n    class DuplicateEmailException {\n      + DuplicateEmailException(message : String)\n    }\n    class ZeroQtyOrderException {\n      + ZeroQtyOrderException(message : String)\n    }\n    DuplicateEmailException --|&gt; RuntimeException\n    ZeroQtyOrderException    --|&gt; RuntimeException\n  }\n}\n\n&#39; ─── DataAccess ──────────────────────────────────────────\npackage \&quot;org.mishu.DataAccess\&quot; {\n  class ConnectionFactory {\n    - {static} DRIVER : String\n    - {static} DB_URL : String\n    - {static} USER : String\n    - {static} PASS : String\n    - {static} instance : ConnectionFactory\n    - ConnectionFactory()\n    + {static} getConnection() : Connection\n    + {static} close(connection : Connection)\n    + {static} close(statement : Statement)\n    + {static} close(resultSet : ResultSet)\n    - createConnection() : Connection\n  }\n\n  package \&quot;org.mishu.DataAccess.Wrappers\&quot; {\n    class DBWrapper&lt;T&gt; {\n      - type : Class&lt;T&gt;\n      + DBWrapper(type : Class&lt;T&gt;)\n      # createSelectQuery(field : String) : String\n      # createSelectLikeQuery(field : String) : String\n      # createObjects(rs : ResultSet) : List&lt;T&gt;\n      + findById(id : int) : T\n      + findAll() : List&lt;T&gt;\n      + get(fieldValue, fieldName, query, settings) : List&lt;T&gt;\n      + insert(object : T) : int\n      + update(object : T)\n      + delete(id : int)\n    }\n\n    class ClientDBWrapper {\n      + ClientDBWrapper(type : Class&lt;Client&gt;)\n      + findByEmail(email : String) : Client\n      + findClientByName(name : String) : Client\n      + findClientsByName(name : String) : List&lt;Client&gt;\n    }\n\n    class ProductDBWrapper {\n      + ProductDBWrapper(type : Class&lt;Product&gt;)\n      + findProductByName(name : String) : Product\n      + findProductsByName(name : String) : List&lt;Product&gt;\n      + findProductsByPrice(price : double) : List&lt;Product&gt;\n      + findProductsByQty(qty : int) : List&lt;Product&gt;\n    }\n\n    class OrdersDBWrapper {\n      + OrdersDBWrapper(type : Class&lt;Orders&gt;)\n      + findByClientId(clientId : int) : List&lt;Orders&gt;\n      + findByProductId(productId : int) : List&lt;Orders&gt;\n    }\n\n    class BillDBWrapper {\n      + BillDBWrapper(type : Class&lt;Bill&gt;)\n      + insertBill(orderId, clientId, productId, qty, total)\n      + findByOrderId(orderId : int) : Bill\n    }\n\n    ClientDBWrapper  --|&gt; DBWrapper\n    ProductDBWrapper --|&gt; DBWrapper\n    OrdersDBWrapper  --|&gt; DBWrapper\n    BillDBWrapper    --|&gt; DBWrapper\n  }\n}\n\n&#39; ─── Business / Validator ────────────────────────────────\npackage \&quot;org.mishu.Business\&quot; {\n  package \&quot;org.mishu.Business.Validator\&quot; {\n    interface Validator&lt;T&gt; {\n      + validate(t : T)\n    }\n\n    class EmailValidator {\n      - EMAIL_PATTERN : String\n      + validate(client : Client)\n    }\n\n    class PriceValidator {\n      + validate(product : Product)\n    }\n\n    class QtyValidator {\n      + validate(product : Product)\n    }\n\n    class OrderValidator {\n      + validate(order : Orders)\n    }\n\n    EmailValidator  ..|&gt; Validator\n    PriceValidator  ..|&gt; Validator\n    QtyValidator    ..|&gt; Validator\n    OrderValidator  ..|&gt; Validator\n  }\n\n  class ClientBLL {\n    - emailValidator : Validator&lt;Client&gt;\n    - dbWrapper : ClientDBWrapper\n    - ordersBLL : OrdersBLL\n    + ClientBLL(ordersBLL : OrdersBLL)\n    + findAll() : List&lt;Client&gt;\n    + findClientByName(name : String) : Client\n    + insertClient(client : Client)\n    + deleteClient(clientId : int)\n    + updateClient(clientId, name, email, address)\n  }\n\n  class ProductBLL {\n    - validators : List&lt;Validator&lt;Product&gt;&gt;\n    - dbWrapper : ProductDBWrapper\n    - ordersBLL : OrdersBLL\n    + ProductBLL(ordersBLL : OrdersBLL)\n    + findProductById(productId : int) : Product\n    + findProductByName(name : String) : Product\n    + findProductsByName(name : String) : List&lt;Product&gt;\n    + insertProduct(product : Product)\n    + findAll() : List&lt;Product&gt;\n    + deleteProduct(productId : int)\n    + updateProduct(productId, name, price, quantity)\n  }\n\n  class OrdersBLL {\n    - validator : Validator&lt;Orders&gt;\n    - dbWrapper : OrdersDBWrapper\n    - productDBWrapper : ProductDBWrapper\n    - clientDBWrapper : ClientDBWrapper\n    - billDBWrapper : BillDBWrapper\n    + OrdersBLL()\n    + findOrderById(orderId : int) : Orders\n    + findByClientId(clientId : int) : List&lt;Orders&gt;\n    + findByProductId(productId : int) : List&lt;Orders&gt;\n    + findAll() : List&lt;Orders&gt;\n    + insertOrder(order : Orders)\n    + deleteOrder(orderId : int)\n    + updateOrder(orderId, clientId, productId, quantity)\n  }\n\n  ClientBLL  --&gt; ClientDBWrapper\n  ClientBLL  --&gt; OrdersBLL\n  ProductBLL --&gt; ProductDBWrapper\n  ProductBLL --&gt; OrdersBLL\n  OrdersBLL  --&gt; OrdersDBWrapper\n  OrdersBLL  --&gt; ProductDBWrapper\n  OrdersBLL  --&gt; ClientDBWrapper\n  OrdersBLL  --&gt; BillDBWrapper\n}\n\n&#39; ─── Presentation ────────────────────────────────────────\npackage \&quot;org.mishu.Presentation\&quot; {\n  class MainFrame {\n    - ordersBLL : OrdersBLL\n    - clientBLL : ClientBLL\n    - productBLL : ProductBLL\n    - selectedClientId : Integer\n    - selectedProductId : Integer\n    + MainFrame()\n    - initUI()\n    - buildClientPanel() : JPanel\n    - buildProductPanel() : JPanel\n    - buildOrderPanel() : JPanel\n    - openNewOrderFrame()\n    - showBillDialog(orderId, productId, qty)\n    - loadClients()\n    - loadProducts()\n    - reloadOrders()\n  }\n\n  MainFrame --&gt; ClientBLL\n  MainFrame --&gt; ProductBLL\n  MainFrame --&gt; OrdersBLL\n}\n\n&#39; ─── Entry point ─────────────────────────────────────────\nclass OrdersManagement {\n  + {static} main(args : String[])\n}\nOrdersManagement --&gt; MainFrame\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="0v3otCO77mmnEKuoZ0zf-3">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1798" width="3305" x="80" y="90" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml package_diagram\ntitle Orders Management System - Package Diagram\n\nskinparam packageStyle rectangle\nskinparam packageFontSize 13\nskinparam ArrowThickness 1.5\n\npackage \&quot;org.mishu\&quot; {\n\n  package \&quot;Presentation\&quot; {\n    [MainFrame]\n  }\n\n  package \&quot;Business\&quot; {\n    [ClientBLL]\n    [ProductBLL]\n    [OrdersBLL]\n\n    package \&quot;Business.Validator\&quot; {\n      [Validator &lt;&lt;interface&gt;&gt;]\n      [EmailValidator]\n      [PriceValidator]\n      [QtyValidator]\n      [OrderValidator]\n    }\n  }\n\n  package \&quot;DataAccess\&quot; {\n    [ConnectionFactory]\n\n    package \&quot;DataAccess.Wrappers\&quot; {\n      [DBWrapper&lt;T&gt;]\n      [ClientDBWrapper]\n      [ProductDBWrapper]\n      [OrdersDBWrapper]\n      [BillDBWrapper]\n    }\n  }\n\n  package \&quot;Model\&quot; {\n    [Client]\n    [Product]\n    [Orders]\n    [Bill]\n  }\n\n  package \&quot;Utils\&quot; {\n    [QuerySettings]\n\n    package \&quot;Utils.Exceptions\&quot; {\n      [DuplicateEmailException]\n      [ZeroQtyOrderException]\n    }\n  }\n}\n\n&#39; ─── Inter-package dependencies ──────────────────────────\nPresentation    ..&gt; Business          : uses\nBusiness        ..&gt; DataAccess        : uses\nBusiness        ..&gt; Model             : uses\nBusiness        ..&gt; \&quot;Utils.Exceptions\&quot;: throws\nDataAccess      ..&gt; Model             : maps\nDataAccess      ..&gt; Utils             : uses\n\&quot;Business.Validator\&quot; ..&gt; Model        : validates\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="0v3otCO77mmnEKuoZ0zf-4">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1099" width="2913" x="80" y="1920" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml use_case_diagram\ntitle Orders Management System - Use Case Diagram\n\nleft to right direction\nskinparam actorStyle awesome\nskinparam usecaseFontSize 12\nskinparam packageStyle rectangle\n\nactor \&quot;User\&quot; as U\nactor \&quot;Database\\n(MySQL)\&quot; as DB\n\nrectangle \&quot;Order Management System\&quot; {\n\n  package \&quot;Client Management\&quot; {\n    usecase \&quot;View All Clients\&quot;       as UC1\n    usecase \&quot;Add Client\&quot;             as UC2\n    usecase \&quot;Update Client\&quot;          as UC3\n    usecase \&quot;Delete Client\&quot;          as UC4\n    usecase \&quot;Validate Client Email\&quot;  as UC5\n    usecase \&quot;Check Duplicate Email\&quot;  as UC6\n  }\n\n  package \&quot;Product Management\&quot; {\n    usecase \&quot;View All Products\&quot;      as UC7\n    usecase \&quot;Add Product\&quot;            as UC8\n    usecase \&quot;Update Product\&quot;         as UC9\n    usecase \&quot;Delete Product\&quot;         as UC10\n    usecase \&quot;Validate Product Price\&quot; as UC11\n    usecase \&quot;Validate Product Qty\&quot;   as UC12\n  }\n\n  package \&quot;Order Management\&quot; {\n    usecase \&quot;View Orders for Client\&quot; as UC13\n    usecase \&quot;Place New Order\&quot;        as UC14\n    usecase \&quot;Delete Order\&quot;           as UC15\n    usecase \&quot;Validate Order Qty\&quot;     as UC16\n    usecase \&quot;Deduct Stock\&quot;           as UC17\n    usecase \&quot;Generate Bill\&quot;          as UC18\n  }\n\n  package \&quot;Billing\&quot; {\n    usecase \&quot;View Bill for Order\&quot;    as UC19\n  }\n}\n\n&#39; ─── User interactions ───────────────────────────────────\nU --&gt; UC1\nU --&gt; UC2\nU --&gt; UC3\nU --&gt; UC4\nU --&gt; UC7\nU --&gt; UC8\nU --&gt; UC9\nU --&gt; UC10\nU --&gt; UC13\nU --&gt; UC14\nU --&gt; UC15\nU --&gt; UC19\n\n&#39; ─── Include/extend relationships ────────────────────────\nUC2  ..&gt; UC5  : &lt;&lt;include&gt;&gt;\nUC3  ..&gt; UC5  : &lt;&lt;include&gt;&gt;\nUC2  ..&gt; UC6  : &lt;&lt;include&gt;&gt;\nUC3  ..&gt; UC6  : &lt;&lt;include&gt;&gt;\n\nUC8  ..&gt; UC11 : &lt;&lt;include&gt;&gt;\nUC8  ..&gt; UC12 : &lt;&lt;include&gt;&gt;\nUC9  ..&gt; UC11 : &lt;&lt;include&gt;&gt;\nUC9  ..&gt; UC12 : &lt;&lt;include&gt;&gt;\n\nUC4  ..&gt; UC13 : &lt;&lt;include&gt;&gt;\\ncheck no orders\n\nUC14 ..&gt; UC16 : &lt;&lt;include&gt;&gt;\nUC14 ..&gt; UC17 : &lt;&lt;include&gt;&gt;\nUC14 ..&gt; UC18 : &lt;&lt;include&gt;&gt;\n\nUC19 ..&gt; UC18 : &lt;&lt;extend&gt;&gt;\n\n&#39; ─── Database interactions ───────────────────────────────\nDB &lt;.. UC1  : query\nDB &lt;.. UC2  : insert\nDB &lt;.. UC3  : update\nDB &lt;.. UC4  : delete\nDB &lt;.. UC7  : query\nDB &lt;.. UC8  : insert\nDB &lt;.. UC9  : update\nDB &lt;.. UC10 : delete\nDB &lt;.. UC13 : query\nDB &lt;.. UC14 : insert\nDB &lt;.. UC15 : delete\nDB &lt;.. UC18 : insert bill\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="0v3otCO77mmnEKuoZ0zf-6">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="2160.22" width="1400" x="3450" y="80" as="geometry" />
          </mxCell>
        </UserObject>
